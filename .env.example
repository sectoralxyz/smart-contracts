# Copy this file to .env and complete it before deploying. Never commit the
# filled-in copy.

# Deployer account that signs and sends every deployment transaction. It must
# hold ETH on Robinhood Chain to pay for gas.
PRIVATE_KEY=0x...

# The address permitted to record KYC results on account records (AccountRegistry).
COMPLIANCE_AUTHORITY=0x...

# USDG (the Global Dollar) is the settlement asset the protocol is designed
# around on Robinhood Chain. ConfidentialToken wraps it, and it is what agents
# spend by default.
USDG_ADDRESS=0x...

# Address of the deployed Groth16 verifier for confidential transfers. If left
# blank, the bundled StubTransferVerifier is deployed for bring-up; replace it
# with the production verifier before wrapping anything of value.
TRANSFER_VERIFIER_ADDRESS=

# Destination for collected fees. When set, the deploy script also deploys the
# FeeSchedule and wires the protocol to use it. When blank, the protocol
# deploys with fees disabled.
TREASURY=

# Blockscout API key used by `forge verify-contract`. An empty value usually works.
BLOCKSCOUT_API_KEY=
